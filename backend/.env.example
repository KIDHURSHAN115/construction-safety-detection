# =============================================================================
# Construction Safety Detection System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- MongoDB ---
# Local MongoDB (default):
MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas (cloud):
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=construction_safety

# --- Security ---
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Default Admin User (created on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
ADMIN_EMAIL=admin@example.com

# --- Detection Settings ---
# Minimum confidence score (0.0 - 1.0) to consider a detection valid
DETECTION_CONFIDENCE=0.50
# Minimum confidence to classify PPE as MISSING (below this = UNCERTAIN)
PPE_CERTAIN_THRESHOLD=0.65

# --- Violation Rules ---
# Seconds a violation must persist before an alert is created
VIOLATION_PERSISTENCE_SECONDS=3.0
# Seconds before the same violation for the same worker can trigger again
ALERT_COOLDOWN_SECONDS=30.0
# Frames to look back when checking persistence (used with FPS)
PERSISTENCE_FRAME_BUFFER=10

# --- Video Processing ---
# Path to the detection model weights
MODEL_PATH=../model_weights/yolov8n.pt
# Maximum width for frame resizing (reduces compute on large streams)
MAX_FRAME_WIDTH=1280
# Process every Nth frame (1 = every frame, 2 = every other frame, etc.)
FRAME_SKIP=1
# Maximum simultaneous video streams
MAX_CONCURRENT_STREAMS=2

# --- Evidence Storage ---
EVIDENCE_DIR=../evidence
# Save a frame image when a violation alert fires
SAVE_EVIDENCE_FRAMES=true
# Maximum evidence images to keep (older ones are deleted)
MAX_EVIDENCE_IMAGES=1000

# --- CORS ---
# Frontend origin during development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
